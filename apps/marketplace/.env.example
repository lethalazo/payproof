# Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Agent wallet private key (hex, no 0x prefix) — used for Base Sepolia and Arc
AGENT_PRIVATE_KEY=...

# Merchant address that receives x402 payments (EVM — Base Sepolia + Arc)
MERCHANT_ADDRESS=0x...

# HTLC contract address on Arc testnet (deploy contracts/HTLC.sol)
HTLC_CONTRACT_ADDRESS=0x...

# Merchant private key (hex, no 0x prefix) — server signs HTLC claim txs on Arc
MERCHANT_PRIVATE_KEY=...

# Treasury address — neutral arbiter for HTLC dispute resolution (EVM)
# This address receives funds when neither buyer nor seller claims within the timelock window.
TREASURY_ADDRESS=0x...

# App URL (used for self-referential API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
